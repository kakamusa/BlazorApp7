@page "/"
@using BlazorApp7.Components.Test

<PageTitle>Home</PageTitle>
 
<h1>Hello, world!</h1>
<EditForm Model=@mdl OnSubmit="Submit">
    <div class="form-group">
        <label for="Name">Name</label>
        <InputText @bind-Value=mdl.Ancode class="form-control" id="Name" />
    </div>
    <div class="form-group">
        <label for="Age">Age</label>
        <InputText @bind-Value=mdl.Andsc class="form-control" id="Age" />
    </div>
    <input type="submit" class="btn btn-primary" value="Save" />
</EditForm>


Welcome to your new app.
<table border="1">
    <tr>
        <th style="border: solid black 1px;">Code</th>
        <th style="border: solid black 1px;">Desc</th>
    </tr>
    @foreach (var row in list)
    {
        <tr>
            <th style="border: solid black 1px;">@row.Ancode</th>
            <th style="border: solid black 1px;">@row.Andsc</th>
        </tr>
    }
</table>
@code
{
    IEnumerable<AnalysisMdl> list = new List<AnalysisMdl>();
    Login mdl = new Login { Ancode = "ancode", Andsc = "andsc" };
    protected override async Task OnInitializedAsync()
    {
        await Submit();
    }
    private async Task Submit()
    {
        string dbcode = "s";
        list = await new AnalysisService().GetAll(dbcode, string.IsNullOrEmpty(mdl.Ancode) ? "ancode" : mdl.Ancode, string.IsNullOrEmpty(mdl.Andsc) ? "andsc" : mdl.Andsc);
    }
    class Login
    {
        public string Ancode { get; set; }
        public string Andsc { get; set; }
    }
}